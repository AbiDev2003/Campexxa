<link href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css" rel="stylesheet">
<div class="container-fluid mb-4">
  <div class="card shadow-sm border-0 p-4">

    <!-- Title -->
    <h3 class="fw-bold mb-1">Edit Profile</h3>
    <p class="text-muted mb-4">Update your profile information</p>

    <form action="/dashboard/profile/update" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <!-- 🔵 Profile Image -->
      <div class="text-center mb-4">
        <img 
          id="profilePreview"
          src="<%= (user && user.profileImage && user.profileImage.url) || '/default-avatar.png' %>"
          class="rounded-circle border"
          style="width:120px; height:120px; object-fit:cover;"
          loading="lazy"
          alt="profile picture main"
        >

        <div class="mt-3">
            <label for="profileInput" class="btn btn-light border btn-sm px-3">Change Photo</label>
            <input type="file" name="profileImage" id="profileInput" hidden>
        </div>
      </div>

      <div class="modal fade" id="cropModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content p-3">
            
                <h4 class="mb-3">Crop Image</h4>

                <div>
                    <img id="cropImage" style="max-width:100%;">
                </div>

                <div class="mt-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="cropDone" class="btn btn-dark">Done</button>
                </div>

            </div>
            </div>
        </div>

      <!-- 🔤 Username -->
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input 
          type="text" 
          id="username"
          name="username" 
          class="form-control" 
          value="<%= user.username %>" 
          required
        >
        <small id="usernameFeedback"></small>
      </div>

      <!-- 👤 Full Name -->
      <div class="mb-3">
        <label for="fullName" class="form-label">Full Name</label>
        <input 
          type="text" 
          name="fullName" 
          id="fullName"
          class="form-control" 
          value="<%= user.fullName %>"
          required
        >
      </div>

      <!-- 📧 Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input 
          type="email" 
          id="email"
          class="form-control bg-light text-muted" 
          value="<%= user.email %>" 
          readonly
        >
      </div>

      <!-- change password link (reusable forgot password) -->
      <a class="auth-forgot" href="/forgot-password">Change password</a>
      <!-- 🚀 Button -->
      <div class="mt-3">
        <button class="btn btn-dark px-4" id="updateBtn" disabled >Update Profile</button>
      </div>

    </form>
  </div>
</div>

<script src="/javascripts/profilePage.js"></script>
<script defer src="/javascripts/usernameCheck.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"></script>