<% layout('layouts/boilerplate') %>
<div class="container mt-4">
  <%- include('./header') %>

  <div class="row">
    <div class="col-md-3">
      <%- include('./sidebar') %>
    </div>
    
    <div class="col-md-9">
      <% if(tab === 'campgrounds'){ %>
        <%- include('./campgrounds') %>
      <% }else if(tab === 'saved'){ %>
        <%- include('./saved') %>
      <% }else if(tab === 'reviews'){ %>
        <%- include('./reviews') %>
      <% }else if(tab === 'profile'){ %>
        <%- include('./profile') %>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/confirmModal') %>

<body 
  data-page="<%= page %>" 
  data-hasmore="<%= tab === 'saved' ? hasMoreSaved : hasMoreCampgrounds %>"
  data-tab="<%= tab %>">

<script src="/javascripts/confirmModal.js"></script>
<script src="/javascripts/loadMore.js"></script>