<% layout('layouts/boilerplate') %>
<link crossorigin="anonymous" href="https://api.mapbox.com/mapbox-gl-js/v3.17.0-beta.1/mapbox-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="/stylesheets/campgrounds.css" />
<style>
  .card-hover:hover {
    box-shadow: 0 0 40px rgba(0,123,255,0.55);
    transform: translateY(-5px);
  }
</style>

<div class="campgrounds-content">
  <div class="d-flex justify-content-between align-items-center mb-1">

    <!-- Filters Button (LEFT) -->
    <button class="btn btn-primary" id="filterToggle" aria-label="Open filters">
      ☰ Filters
    </button>

    <!-- Sort Dropdown (RIGHT) -->
    <div class="d-flex align-items-center">
      <label for="campground-sort" class="me-2 text-muted fw-semibold mb-0">Sort by:</label>
      <select id="campground-sort" class="form-select" style="width: 180px;">
        <option value="">Sort by</option>
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="ratingHighLow">Ratings: High to low</option>
        <option value="ratingLowHigh">Ratings: Low to High</option>
        <option value="distanceNear">Distance: Near to far</option>
        <option value="distanceFar">Distance: Far to near</option>
        <option value="priceHighLow">Cost: High to low</option>
        <option value="priceLowHigh">Cost: Low to High</option>
      </select>
    </div>

  </div>

  <!-- MAP + FILTER UI -->
  <div class="map-wrapper">
    <div class="filters-overlay" id="filtersPanel">
      <%- include('filters') %>
    </div>

    <div id="cluster-map"></div>
  </div>
  
    <div class="container my-4">
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        <% for(let campground of campgrounds){ %>
          <div class="col">
            <%- include('../partials/campCard', { camp: campground }) %>
          </div>
        <% } %>
      </div>

      <%- include('../partials/loadInfinityScroll', { hasMore, page, tab: '' }) %>

    </div>
  </main>
</div>

<body 
  data-mapbox="<%= process.env.MAPBOX_TOKEN %>"
  data-page="<%= page %>"
  data-hasmore="<%= hasMore %>">

<div id="campgrounds-data" data-features='<%- JSON.stringify(campgrounds) %>'></div>

<script src="/javascripts/config.js"></script>
<script src="/javascripts/map.js"></script>

  
<script defer src="/javascripts/geoLocation.js"></script>
<script defer src="/javascripts/sort.js"></script>
<script defer src="/javascripts/indexPage.js"></script>
<script src="/javascripts/loadMore.js"></script>



